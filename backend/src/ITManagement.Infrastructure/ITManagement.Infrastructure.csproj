<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ITManagement.Application\ITManagement.Application.csproj" />
    <ProjectReference Include="..\ITManagement.Domain\ITManagement.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core framework reference: IHttpContextAccessor, DI extensions -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- EF Core Identity integration -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Bản vá bảo mật cho dependency được Microsoft.Data.SqlClient sử dụng. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Giữ migration PostgreSQL để tham khảo; SQL Server dùng snapshot mới riêng. -->
    <Compile Remove="Persistence\Migrations\**\*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
    